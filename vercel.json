{
    "cleanUrls":  true,
    "trailingSlash":  false,
    "rewrites":  [
                     {
                         "source":  "/admin",
                         "destination":  "/index.html"
                     },
                     {
                         "source":  "/api/admin-session",
                         "destination":  "/api/admin/action"
                     },
                     {
                         "source":  "/api/admins",
                         "destination":  "/api/admin/action"
                     },
                     {
                         "source":  "/api/auth/google/logout",
                         "destination":  "/api/auth/google/callback"
                     }
                 ],
    "headers":  [
                    {
                        "headers":  [
                                        {
                                            "key":  "Cache-Control",
                                            "value":  "no-store, no-cache, must-revalidate, proxy-revalidate"
                                        },
                                        {
                                            "key":  "Pragma",
                                            "value":  "no-cache"
                                        },
                                        {
                                            "key":  "Expires",
                                            "value":  "0"
                                        }
                                    ],
                        "source":  "/(.*)"
                    }
                ]
}
