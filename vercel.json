{
  "version": 2,
  "name": "pushkarik-upgrader",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/index.html?admin=true"
    },
    {
      "source": "/((?!api/|_next/|_static/|favicon.ico|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
